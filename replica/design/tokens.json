{
  "meta": {
    "name": "NoteFlow Design Tokens",
    "version": "1.0.0",
    "description": "Design system for NoteFlow Android app - handwriting & PDF annotation",
    "author": "replica-design",
    "colorSpace": "sRGB"
  },
  "color": {
    "roles": {
      "bg": { "light": "#F8F9FA", "dark": "#1A1C1E" },
      "bgElevated": { "light": "#FFFFFF", "dark": "#242629" },
      "surface": { "light": "#FFFFFF", "dark": "#242629" },
      "surfaceContainer": { "light": "#F1F3F4", "dark": "#2D2F31" },
      "surfaceContainerHigh": { "light": "#E8EAED", "dark": "#36383B" },
      "surfaceContainerHighest": { "light": "#D0D5DD", "dark": "#414345" },
      "border": { "light": "#DADCE0", "dark": "#4A4C4F" },
      "borderInput": { "light": "#80868B", "dark": "#7E8083" },
      "borderFocus": { "light": "#1A73E8", "dark": "#8AB4F8" },
      "text": { "light": "#202124", "dark": "#E8EAED" },
      "textSecondary": { "light": "#5F6368", "dark": "#9AA0A6" },
      "textTertiary": { "light": "#80868B", "dark": "#80868B" },
      "textInverse": { "light": "#FFFFFF", "dark": "#202124" },
      "textOnAccent": { "light": "#FFFFFF", "dark": "#000000" },
      "accent": { "light": "#1A73E8", "dark": "#8AB4F8" },
      "accentContainer": { "light": "#E8F0FE", "dark": "#1A3A5C" },
      "accentHover": { "light": "#1558B0", "dark": "#AECBFA" },
      "accentPressed": { "light": "#0D47A1", "dark": "#D2E3FC" },
      "danger": { "light": "#D93025", "dark": "#F28B82" },
      "dangerContainer": { "light": "#FCE8E6", "dark": "#5C1A15" },
      "success": { "light": "#188038", "dark": "#81C995" },
      "successContainer": { "light": "#E6F4EA", "dark": "#143D1F" },
      "warning": { "light": "#F9AB00", "dark": "#FDD663" },
      "warningContainer": { "light": "#FFF8E1", "dark": "#4A3400" },
      "onSurface": { "light": "#1D1D1F", "dark": "#E6E1E5" },
      "onSurfaceVariant": { "light": "#49454F", "dark": "#CAC4D0" },
      "shadow": { "light": "#000000", "dark": "#000000" },
      "scrim": { "light": "#000000", "dark": "#000000" },
      "backdrop": { "light": "#000000", "dark": "#000000" },
      "divider": { "light": "#DADCE0", "dark": "#4A4C4F" }
    },
    "toolColors": {
      "pen": [
        { "name": "black", "hex": "#000000" },
        { "name": "blue", "hex": "#1A73E8" },
        { "name": "red", "hex": "#D93025" },
        { "name": "green", "hex": "#188038" },
        { "name": "purple", "hex": "#8E24AA" },
        { "name": "orange", "hex": "#F9AB00" }
      ],
      "highlighter": [
        { "name": "yellow", "hex": "#FFF59D", "opacity": 0.4 },
        { "name": "green", "hex": "#A5D6A7", "opacity": 0.4 },
        { "name": "pink", "hex": "#F8BBD0", "opacity": 0.4 },
        { "name": "blue", "hex": "#90CAF9", "opacity": 0.4 },
        { "name": "orange", "hex": "#FFE082", "opacity": 0.4 }
      ],
      "eraser": { "name": "eraser", "hex": "#FFFFFF" }
    }
  },
  "typography": {
    "fontFamilies": {
      "sans": "Inter, system-ui, sans-serif",
      "mono": "JetBrains Mono, monospace",
      "handwriting": "Patrick Hand, cursive"
    },
    "scale": [
      { "name": "displayLarge", "size": 57, "lineHeight": 64, "weight": 400, "letterSpacing": -0.25 },
      { "name": "displayMedium", "size": 45, "lineHeight": 52, "weight": 400, "letterSpacing": 0 },
      { "name": "displaySmall", "size": 36, "lineHeight": 44, "weight": 400, "letterSpacing": 0 },
      { "name": "headlineLarge", "size": 32, "lineHeight": 40, "weight": 600, "letterSpacing": 0 },
      { "name": "headlineMedium", "size": 28, "lineHeight": 36, "weight": 600, "letterSpacing": 0 },
      { "name": "headlineSmall", "size": 24, "lineHeight": 32, "weight": 600, "letterSpacing": 0 },
      { "name": "titleLarge", "size": 22, "lineHeight": 28, "weight": 600, "letterSpacing": 0 },
      { "name": "titleMedium", "size": 16, "lineHeight": 24, "weight": 500, "letterSpacing": 0.15 },
      { "name": "titleSmall", "size": 14, "lineHeight": 20, "weight": 500, "letterSpacing": 0.1 },
      { "name": "bodyLarge", "size": 16, "lineHeight": 24, "weight": 400, "letterSpacing": 0.5 },
      { "name": "bodyMedium", "size": 14, "lineHeight": 20, "weight": 400, "letterSpacing": 0.25 },
      { "name": "bodySmall", "size": 12, "lineHeight": 16, "weight": 400, "letterSpacing": 0.4 },
      { "name": "labelLarge", "size": 14, "lineHeight": 20, "weight": 500, "letterSpacing": 0.1 },
      { "name": "labelMedium", "size": 12, "lineHeight": 16, "weight": 500, "letterSpacing": 0.5 },
      { "name": "labelSmall", "size": 11, "lineHeight": 16, "weight": 500, "letterSpacing": 0.5 }
    ]
  },
  "spacing": {
    "base": 4,
    "scale": [0, 4, 8, 12, 16, 20, 24, 28, 32, 36, 40, 48, 56, 64, 72, 80, 96, 112, 128]
  },
  "borderRadius": {
    "none": 0,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "full": 9999,
    "pill": 9999
  },
  "shadow": {
    "elevation1": { "x": 0, "y": 1, "blur": 2, "spread": 0, "color": "shadow", "opacity": 0.3 },
    "elevation2": { "x": 0, "y": 2, "blur": 4, "spread": 0, "color": "shadow", "opacity": 0.3 },
    "elevation3": { "x": 0, "y": 4, "blur": 8, "spread": 0, "color": "shadow", "opacity": 0.3 },
    "elevation4": { "x": 0, "y": 8, "blur": 16, "spread": 0, "color": "shadow", "opacity": 0.3 },
    "elevation5": { "x": 0, "y": 12, "blur": 24, "spread": 0, "color": "shadow", "opacity": 0.3 }
  },
  "motion": {
    "duration": {
      "instant": 0,
      "fast": 100,
      "medium": 200,
      "slow": 300,
      "xslow": 500
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "accelerate": "cubic-bezier(0.4, 0, 1, 1)",
      "decelerate": "cubic-bezier(0, 0, 0.2, 1)",
      "emphasized": "cubic-bezier(0.2, 0, 0, 1)"
    }
  },
  "layout": {
    "breakpoints": {
      "phone": 0,
      "tablet": 600,
      "desktop": 1240
    },
    "maxContentWidth": 1280,
    "headerHeight": 64,
    "bottomBarHeight": 56,
    "fabSize": 56,
    "toolbarHeight": 48,
    "paletteHeight": 280,
    "pageThumbnailSize": { "width": 96, "height": 128 }
  },
  "canvas": {
    "minZoom": 0.25,
    "maxZoom": 4.0,
    "defaultZoom": 1.0,
    "zoomStep": 0.25,
    "panFriction": 0.95,
    "infiniteCanvasBounds": { "width": 100000, "height": 100000 }
  },
  "inks": {
    "pen": {
      "minWidth": 0.5,
      "maxWidth": 12,
      "defaultWidth": 2,
      "pressureSensitivity": 0.8,
      "smoothing": 0.7,
      "cap": "round",
      "join": "round"
    },
    "fountainPen": {
      "minWidth": 0.3,
      "maxWidth": 8,
      "defaultWidth": 1.5,
      "pressureSensitivity": 1.0,
      "smoothing": 0.6,
      "cap": "round",
      "join": "round"
    },
    "brush": {
      "minWidth": 2,
      "maxWidth": 40,
      "defaultWidth": 8,
      "pressureSensitivity": 1.0,
      "smoothing": 0.5,
      "cap": "round",
      "join": "round"
    },
    "highlighter": {
      "minWidth": 8,
      "maxWidth": 60,
      "defaultWidth": 20,
      "pressureSensitivity": 0.3,
      "smoothing": 0.8,
      "cap": "square",
      "join": "bevel",
      "blendMode": "multiply"
    },
    "eraser": {
      "minWidth": 8,
      "maxWidth": 80,
      "defaultWidth": 24,
      "modes": ["stroke", "area", "object"]
    },
    "shape": {
      "minWidth": 1,
      "maxWidth": 8,
      "defaultWidth": 2,
      "strokeCap": "butt",
      "strokeJoin": "miter"
    }
  },
  "pairs": [
    { "text": "text", "background": "bg", "level": "AA" },
    { "text": "text", "background": "bgElevated", "level": "AA" },
    { "text": "text", "background": "surface", "level": "AA" },
    { "text": "text", "background": "surfaceContainer", "level": "AA" },
    { "text": "text", "background": "surfaceContainerHigh", "level": "AA" },
    { "text": "textSecondary", "background": "bg", "level": "AA" },
    { "text": "textSecondary", "background": "surface", "level": "AA" },
    { "text": "textTertiary", "background": "bg", "level": "AA" },
    { "text": "textTertiary", "background": "surface", "level": "AA" },
    { "text": "textInverse", "background": "accent", "level": "AA" },
    { "text": "textOnAccent", "background": "accent", "level": "AA" },
    { "text": "textOnAccent", "background": "accentContainer", "level": "AA" },
    { "text": "text", "background": "accentContainer", "level": "AA" },
    { "text": "text", "background": "dangerContainer", "level": "AA" },
    { "text": "text", "background": "successContainer", "level": "AA" },
    { "text": "text", "background": "warningContainer", "level": "AA" },
    { "text": "textSecondary", "background": "surfaceContainerHigh", "level": "AA" },
    { "text": "text", "background": "surfaceContainerHighest", "level": "AA" },
    { "text": "border", "background": "bg", "level": "AAlarge" },
    { "text": "borderInput", "background": "bg", "level": "AAlarge" },
    { "text": "borderFocus", "background": "bg", "level": "AAlarge" }
  ]
}